# Credenciais da service account do Firebase Admin SDK, usadas só pelo
# backend (api/enviar-push.ts) pra enviar push notifications.
#
# Como gerar: Firebase Console → Configurações do projeto (⚙️) → Contas de
# serviço → Gerar nova chave privada. Baixa um .json — copia os 3 campos
# abaixo dele pra cá (NUNCA commita o .json nem o .env preenchido).
#
# Em produção (Vercel): cadastra essas 3 variáveis em
# Project Settings → Environment Variables.

FIREBASE_PROJECT_ID=jumo-d9094
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
