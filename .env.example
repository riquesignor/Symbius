# ── Backend (api/*.ts, só roda na Vercel) ──────────────────────────────────
#
# Credenciais da service account do Firebase Admin SDK, usadas pro backend
# enviar push notifications e validar tokens.
#
# Como gerar: Firebase Console → Configurações do projeto (⚙️) → Contas de
# serviço → Gerar nova chave privada. Baixa um .json — copia os 3 campos
# abaixo dele pra cá (NUNCA commita o .json nem o .env preenchido).
#
# Em produção (Vercel): cadastra essas variáveis em
# Project Settings → Environment Variables.

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Segredo compartilhado que protege o cron de lembretes (api/cron-lembretes.ts).
# Gere uma string aleatória (ex: openssl rand -hex 32) e cadastre a mesma
# também no header "Authorization: Bearer <valor>" configurado no cron da Vercel.
CRON_SECRET=

# ── App (React Native / Expo — valores client-side, não são segredo) ───────
#
# Firebase Console → Configurações do projeto → Seus apps → app Web →
# "Configuração do SDK". Precisam do prefixo EXPO_PUBLIC_ pro Expo embutir
# no bundle do app.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
