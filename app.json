{
  "expo": {
    "name": "Symbius",
    "slug": "JUMO",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.riquesignor.JUMO",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "updates": {
      "enabled": false
    },
    "extra": {
      "eas": {
        "projectId": "486c40c2-3997-4660-898b-e4e292260e1c"
      }
    },
    "plugins": [
      "expo-font",
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      "expo-build-properties",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "O Symbius precisa acessar suas fotos para você enviar imagens no chat e trocar sua foto de perfil.",
          "cameraPermission": "O Symbius precisa acessar a câmera para você tirar fotos e enviar no chat ou no perfil."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#1F3D2B"
        }
      ]
    ]
  }
}
